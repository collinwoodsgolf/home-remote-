<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Broadcasting the Broadlink discovery packet to 255.255.255.255 requires
	  the multicast networking entitlement. This is a managed entitlement: you
	  must request it from Apple (https://developer.apple.com/contact/request/networking-multicast)
	  and include it in your provisioning profile. Without it, discovery is
	  blocked but you can still add a hub by typing its IP manually.
	-->
	<key>com.apple.developer.networking.multicast</key>
	<true/>
</dict>
</plist>
